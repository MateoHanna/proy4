{
  "name": "flutter_api",
  "version": "1.0.0",
  "description": "REST API for Flutter app using Node.js, Express, MongoDB, and TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpileOnly src/server.ts"
  },
  "dependencies": {
    "dotenv": "^16.1.4",
    "express": "^4.18.2",
    "mongoose": "^7.2.0"
  },
  "optionalDependencies": {
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
